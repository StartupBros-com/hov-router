{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "esnext",
		"target": "esnext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"allowJs": true,
		"resolveJsonModule": true,
		"noUncheckedSideEffectImports": false,
		"types": ["bun-types"],
		"jsx": "react-jsx",
		"paths": {
			"@hov-router/providers/server-tool-capabilities": [
				"./packages/providers/src/server-tool-capabilities.ts"
			],
			"@hov-router/types/combo": ["./packages/types/src/combo.ts"],
			"@hov-router/types/request": ["./packages/types/src/request.ts"],
			"@hov-router/*": ["./packages/*/src"],
			"@hov-router/server": ["./apps/server/src/server.ts"],
			"@hov-router/dashboard-web/dist/*": ["./packages/dashboard-web/dist/*"]
		}
	},
	"include": ["packages/*/src/**/*", "apps/*/src/**/*"],
	"exclude": ["**/__tests__", "**/*.test.ts", "**/*.test.tsx"]
}
