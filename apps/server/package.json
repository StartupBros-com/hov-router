{
	"name": "@hov-router/server",
	"version": "0.1.0",
	"type": "module",
	"main": "./src/server.ts",
	"scripts": {
		"dev": "bun run --hot src/server.ts",
		"start": "bun run src/server.ts",
		"build": "bun build src/server.ts --compile --outfile dist/hov-router-server",
		"typecheck": "bunx tsc --noEmit"
	},
	"dependencies": {
		"@hov-router/core": "workspace:*",
		"@hov-router/core-di": "workspace:*",
		"@hov-router/database": "workspace:*",
		"@hov-router/config": "workspace:*",
		"@hov-router/logger": "workspace:*",
		"@hov-router/load-balancer": "workspace:*",
		"@hov-router/proxy": "workspace:*",
		"@hov-router/dashboard-web": "workspace:*",
		"@hov-router/http-api": "workspace:*",
		"@hov-router/security": "workspace:*",
		"@hov-router/types": "workspace:*",
		"@hov-router/openai-responses-adapter": "workspace:*"
	}
}
